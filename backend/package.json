{
  "name": "project-money-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "node --test --test-concurrency=1 test/unit/*.test.js test/property/*.test.js test/api/*.test.js",
    "test:unit": "node --test --test-concurrency=1 test/unit/*.test.js",
    "test:property": "node --test --test-concurrency=1 test/property/*.test.js",
    "test:api": "node --test --test-concurrency=1 test/api/*.test.js",
    "test:coverage": "node --test --test-concurrency=1 --experimental-test-coverage test/unit/*.test.js test/property/*.test.js test/api/*.test.js"
  },
  "dependencies": {
    "@libsql/client": "^0.14.0",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "express-async-errors": "^3.1.1",
    "express-rate-limit": "^7.4.0",
    "express-validator": "^7.2.0",
    "google-auth-library": "^9.15.1",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "nanoid": "^5.0.7",
    "resend": "^6.38.1"
  },
  "devDependencies": {
    "fast-check": "^4.10.3",
    "supertest": "^7.3.2"
  }
}
