PORT=4000
# Local development stays on loopback unless an orchestrator explicitly overrides it.
HOST=127.0.0.1
JWT_SECRET=replace-with-a-long-random-secret-in-production
# Dedicated generated secret (at least 32 bytes); do not reuse JWT_SECRET.
FINANCIAL_MUTATION_HMAC_KEY=replace-with-a-dedicated-random-secret-at-least-32-bytes
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173
# Disabled by default. Enable only for code-only canonical/legacy comparison logs.
CLARITY_SHADOW_COMPARE=false
# Structured operational logs: debug, info, warn, error, or silent.
OPERATIONAL_LOG_LEVEL=info
# Comma-separated emails that get promoted to admin on login or register.
ADMIN_EMAILS=
# Turso (libsql) connection — required.
TURSO_DATABASE_URL=libsql://your-db.turso.io
TURSO_AUTH_TOKEN=paste-token-here
