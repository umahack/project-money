PORT=4000
JWT_SECRET=replace-with-a-long-random-secret-in-production
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173
# Comma-separated emails that get promoted to admin on login or register.
ADMIN_EMAILS=
# Turso (libsql) connection — required.
TURSO_DATABASE_URL=libsql://your-db.turso.io
TURSO_AUTH_TOKEN=paste-token-here
