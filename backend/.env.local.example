# Backend local-dev config. Copy to backend/.env (git-ignored) and fill in.
# Use a SEPARATE Turso database for local testing so you never touch prod data.
#
# Create the staging DB once:
#   turso db create project-money-staging
#   turso db show project-money-staging --url
#   turso db tokens create project-money-staging --expiration none
#
# Paste the URL and token below.

PORT=4000
NODE_ENV=development

# Any 24+ char random string works locally — doesn't have to match prod.
JWT_SECRET=local-dev-replace-me-with-something-random-and-long

# Dev frontend is on 5173 by default.
CORS_ORIGIN=http://localhost:5173

# Promote your own email to admin on first local sign-in.
ADMIN_EMAILS=your@email.com

# Staging Turso DB — separate from prod.
TURSO_DATABASE_URL=libsql://project-money-staging-<yourname>.turso.io
TURSO_AUTH_TOKEN=paste-staging-token-here

# Resend is optional for local work. If unset, OTP codes are printed to
# the server's stdout so you can finish sign-up without sending real email.
# RESEND_API_KEY=
# MAIL_FROM="Project Money <no-reply@project-money.online>"

# Keep local clock aligned with prod.
TZ=Asia/Kolkata
