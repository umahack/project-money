{
  "name": "project-money-frontend",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "generate:parser-validator-fixture": "UPDATE_PARSER_VALIDATOR_FIXTURE=1 vitest run src/clarity/quickAdd/parserServerFixture.test.ts",
    "test:e2e": "playwright test",
    "test:e2e:quickadd": "playwright test -c playwright.quickadd.config.ts",
    "test:e2e:typecheck": "tsc --noEmit -p e2e/tsconfig.json",
    "test:e2e:install": "playwright install chromium",
    "android": "npm run android:sync:debug && CAPACITOR_ENV=debug npx cap open android",
    "android:build": "vite build --mode android",
    "android:sync": "npm run android:build && CAPACITOR_ENV=release npx cap sync android",
    "android:sync:debug": "npm run build && CAPACITOR_ENV=debug npx cap sync android",
    "android:run": "npm run android:sync:debug && CAPACITOR_ENV=debug npx cap run android",
    "android:release": "npm run android:sync && cd android && ./gradlew bundleRelease assembleRelease",
    "android:verify": "node scripts/android/verify.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.2",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.6.2",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/keyboard": "^8.0.6",
    "@capacitor/share": "^8.0.3",
    "@capacitor/status-bar": "^8.0.4",
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.1.0",
    "@fontsource-variable/outfit": "^5.1.0",
    "@tanstack/react-query": "^5.108.0",
    "framer-motion": "^11.11.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.5"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.2",
    "@playwright/test": "^1.65.1",
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitest/coverage-v8": "^5.1.1",
    "axe-core": "^4.14.1",
    "fast-check": "^4.10.3",
    "jsdom": "^29.1.1",
    "typescript": "^5.6.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.1",
    "vitest-axe": "^0.1.0"
  },
  "engines": {
    "node": ">=20"
  }
}
