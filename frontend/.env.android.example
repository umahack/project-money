# Copy to frontend/.env.android (gitignored) before running `npm run android:sync`
# or `npm run android:build`. Vite loads it automatically for `--mode android`, and
# capacitor.config.ts reads VITE_API_BASE from it to build server.allowNavigation.
# Nothing in this file is a secret: every VITE_* value is baked into the public bundle.

# Production API origin. Must start with https:// (the Android build and the release
# Capacitor config both fail otherwise). No trailing slash.
VITE_API_BASE=https://project-money-api.onrender.com

# Keep the legacy UI/read contract in the Android release until the Financial Clarity
# rollout is enabled for the API.
VITE_FINANCIAL_CLARITY_ENABLED=false

# Quick Add and the Home headline. Off by default; has no effect unless
# VITE_FINANCIAL_CLARITY_ENABLED=true.
VITE_QUICK_ADD_ENABLED=false
