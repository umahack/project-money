# Copy this file to keystore.properties (gitignored) and fill in the real values.
# Never commit keystore.properties or the keystore itself; keep two offline copies of the keystore.
#
# Create the upload keystore once with:
#   keytool -genkeypair -v -keystore ~/keys/project-money-upload.jks -alias upload \
#           -keyalg RSA -keysize 2048 -validity 10000
#
# storeFile may be absolute, or relative to frontend/android.
storeFile=/absolute/path/to/project-money-upload.jks
storePassword=CHANGE_ME
keyAlias=upload
keyPassword=CHANGE_ME
